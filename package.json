{
  "name": "ai-rmf-oscal-catalog",
  "version": "0.4.0",
  "description": "Tooling deps for OSCAL schema validation of AI RMF catalog and tier profiles",
  "private": true,
  "license": "CC0-1.0",
  "scripts": {
    "validate-catalog": "ajv validate -s schemas/oscal_catalog_schema.json -d catalogs/ai-rmf-v0.4.json -c ajv-formats --strict=false --spec=draft7",
    "validate-profile-baseline": "ajv validate -s schemas/oscal_profile_schema.json -d profiles/ai-rmf-baseline-profile.json -c ajv-formats --strict=false --spec=draft7",
    "validate-profile-tier-1": "ajv validate -s schemas/oscal_profile_schema.json -d profiles/ai-rmf-tier-1-foundational-profile.json -c ajv-formats --strict=false --spec=draft7",
    "validate-profile-tier-2": "ajv validate -s schemas/oscal_profile_schema.json -d profiles/ai-rmf-tier-2-customer-facing-profile.json -c ajv-formats --strict=false --spec=draft7",
    "validate-profile-tier-3": "ajv validate -s schemas/oscal_profile_schema.json -d profiles/ai-rmf-tier-3-high-risk-profile.json -c ajv-formats --strict=false --spec=draft7",
    "validate-profiles": "npm run validate-profile-baseline && npm run validate-profile-tier-1 && npm run validate-profile-tier-2 && npm run validate-profile-tier-3",
    "validate": "npm run validate-catalog && npm run validate-profiles"
  },
  "devDependencies": {
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1"
  }
}
